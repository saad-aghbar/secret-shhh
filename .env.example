# Names only. Never put real secrets in this file.
# Copy to .env.local for development. Set the same keys in Vercel for production.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# required in production (public https URL, not localhost)
# Production: https://shhh-one-zeta.vercel.app
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=
# optional — defaults to Shhh
NEXT_PUBLIC_APP_NAME=

# -----------------------------------------------------------------------------
# Auth / database (required)
# -----------------------------------------------------------------------------
DATABASE_URL=
AUTHORIZED_USER_1_DISPLAY_NAME=
AUTHORIZED_USER_2_DISPLAY_NAME=
# Argon2id hashes. Generate with: pnpm auth:hash-pin  (must use base64:… form)
AUTHORIZED_USER_1_PIN_HASH=
AUTHORIZED_USER_2_PIN_HASH=
# 32+ characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
# optional
AUTH_PIN_MIN_LENGTH=
AUTH_SESSION_DAYS=

# -----------------------------------------------------------------------------
# Supabase Realtime (optional — typing + instant notify)
# Browser-safe. Never use the service_role key here.
# If Postgres is hosted on the same Supabase project, revoke table grants for
# anon/authenticated. The app uses Drizzle + DATABASE_URL, not PostgREST.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# R2 (required in production)
# Server secrets only. Never NEXT_PUBLIC_*.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# optional force: test | r2  (test is forbidden in Vercel production)
STORAGE_PROVIDER=
# optional size overrides (bytes)
MAX_IMAGE_BYTES=
MAX_VIDEO_BYTES=
MAX_AUDIO_BYTES=
MESSAGE_TEXT_MAX_LENGTH=

# -----------------------------------------------------------------------------
# LiveKit Cloud (required in production)
# Server secrets only. LIVEKIT_URL must be wss://…livekit.cloud
# -----------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# YouTube / music providers (optional)
# Server secrets only. Paste-link still works without YOUTUBE_API_KEY.
# Apple Music uses keyless iTunes lookup — no env.
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional testing (never enable in production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_SW=
E2E_PASSWORD=
E2E_FORCE_CHAT_FAIL=

# -----------------------------------------------------------------------------
# Production
# Vercel sets VERCEL_ENV=production. Do not set localhost URLs there.
# Optional build id shown only on /api/health
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BUILD_ID=
